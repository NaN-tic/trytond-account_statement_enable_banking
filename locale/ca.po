msgctxt "model:ir.message,text:msg_valid_days_out_of_range"
msgid "The Enable Banking Session Valid Days fields must be between 1 and 90 days."
msgstr "El camp Dies validesa sessió Enable Banking han de tenir entre 1 i 90 dies."

