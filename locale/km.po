#, python-format
msgctxt "model:ir.message,text:msg_account_not_found"
msgid ""
"Account \"%(account)s\" not found in session from bank \"%(bank)s\" make sure"
" the account number is correct."
msgstr ""
"រកមិនឃើញគណនី «%(account)s» ក្នុងសម័យប្រើប្រាស់របស់ធនាគារ «%(bank)s»។ "
"សូមពិនិត្យថាលេខគណនីត្រឹមត្រូវ។"

#, python-format
msgctxt "model:ir.message,text:msg_aspsp_not_found"
msgid ""
"Bank \"%(bank)s\" from country \"%(country_code)s\" not found in Enable "
"Banking compatible banks.\\n%(message)s"
msgstr ""
"រកមិនឃើញធនាគារ «%(bank)s» នៃប្រទេស «%(country_code)s» "
"ក្នុងបញ្ជីធនាគារដែលអាចប្រើជាមួយ Enable Banking។\\n%(message)s"

