#, python-format
msgctxt "model:ir.message,text:msg_account_not_found"
msgid ""
"Account \"%(account)s\" not found in session from bank \"%(bank)s\" make "
"sure the account number is correct."
msgstr "在银行“%(bank)s”的会话中找不到账户“%(account)s”，请确认账号正确。"

#, python-format
msgctxt "model:ir.message,text:msg_aspsp_not_found"
msgid ""
"Bank \"%(bank)s\" from country \"%(country_code)s\" not found in Enable "
"Banking compatible banks.\\n%(message)s"
msgstr ""
"在 Enable Banking 支持的银行中找不到国家“%(country_code)s”的银行“%(bank)s”。\\n%(message)s"

#, python-format
